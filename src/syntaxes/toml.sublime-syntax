%YAML 1.2
---
# TOML (https://toml.io/en/v1.0.0), written for Raido. Its scopes are the ones
# Raido's themes color: comments, strings, numbers, constants, keys as variables,
# table headers as types.
name: TOML
file_extensions:
  - toml
scope: source.toml

variables:
  bare_key: '[A-Za-z0-9_-]+'
  dec: '[0-9](?:_?[0-9])*'
  date: '[0-9]{4}-[0-9]{2}-[0-9]{2}'
  time: '[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\.[0-9]+)?'
  offset: '(?:[Zz]|[+-][0-9]{2}:[0-9]{2})'
  end: '(?=\s*(?:$|[,\]}#]))'

contexts:
  main:
    - include: comments
    - match: '^\s*(\[\[)'
      captures:
        1: punctuation.definition.table.array.begin.toml
      push: table-array
    - match: '^\s*(\[)'
      captures:
        1: punctuation.definition.table.begin.toml
      push: table
    - include: keys
    - match: '='
      scope: keyword.operator.assignment.toml
      push: value

  comments:
    - match: '#.*$'
      scope: comment.line.number-sign.toml

  # key, "quoted key", 'literal key', dotted.key
  keys:
    - match: '{{bare_key}}'
      scope: variable.other.key.toml
    - match: '"'
      scope: punctuation.definition.key.begin.toml
      push: key-basic
    - match: "'"
      scope: punctuation.definition.key.begin.toml
      push: key-literal
    - match: '\.'
      scope: punctuation.accessor.dot.toml

  key-basic:
    - meta_scope: variable.other.key.toml
    - match: '"'
      scope: punctuation.definition.key.end.toml
      pop: true
    - include: escapes
    - match: '$'
      pop: true

  key-literal:
    - meta_scope: variable.other.key.toml
    - match: "'"
      scope: punctuation.definition.key.end.toml
      pop: true
    - match: '$'
      pop: true

  # [table] and [[array.of.tables]]: the names stand out as types.
  table:
    - meta_scope: meta.table.toml
    - match: '\]'
      scope: punctuation.definition.table.end.toml
      pop: true
    - include: table-names

  table-array:
    - meta_scope: meta.table.array.toml
    - match: '\]\]'
      scope: punctuation.definition.table.array.end.toml
      pop: true
    - include: table-names

  table-names:
    - match: '{{bare_key}}'
      scope: entity.name.type.table.toml
    - match: '"(?:[^"\\]|\\.)*"'
      scope: entity.name.type.table.toml
    - match: "'[^']*'"
      scope: entity.name.type.table.toml
    - match: '\.'
      scope: punctuation.accessor.dot.toml
    - match: '$'
      pop: true

  # One value after `=` or in an array.
  value:
    - match: '"""'
      scope: punctuation.definition.string.begin.toml
      set: string-basic-multiline
    - match: "'''"
      scope: punctuation.definition.string.begin.toml
      set: string-literal-multiline
    - match: '"'
      scope: punctuation.definition.string.begin.toml
      set: string-basic
    - match: "'"
      scope: punctuation.definition.string.begin.toml
      set: string-literal
    - match: '\['
      scope: punctuation.section.array.begin.toml
      set: array
    - match: '\{'
      scope: punctuation.section.inline-table.begin.toml
      set: inline-table
    - match: '{{date}}(?:[Tt ]{{time}}{{offset}}?)?{{end}}'
      scope: constant.other.datetime.toml
      pop: true
    - match: '{{time}}{{end}}'
      scope: constant.other.time.toml
      pop: true
    - match: '[+-]?(?:inf|nan){{end}}'
      scope: constant.numeric.float.toml
      pop: true
    - match: '0x[0-9A-Fa-f](?:_?[0-9A-Fa-f])*{{end}}'
      scope: constant.numeric.integer.hexadecimal.toml
      pop: true
    - match: '0o[0-7](?:_?[0-7])*{{end}}'
      scope: constant.numeric.integer.octal.toml
      pop: true
    - match: '0b[01](?:_?[01])*{{end}}'
      scope: constant.numeric.integer.binary.toml
      pop: true
    - match: '[+-]?{{dec}}(?:\.{{dec}})?(?:[eE][+-]?{{dec}})?{{end}}'
      scope: constant.numeric.toml
      pop: true
    - match: '(?:true|false){{end}}'
      scope: constant.language.boolean.toml
      pop: true
    - include: comments
    - match: '$'
      pop: true
    # Not a value: marked, and one character taken so nothing loops on it.
    - match: '[^\s,\]}]'
      scope: invalid.illegal.value.toml
      pop: true

  array:
    - meta_scope: meta.array.toml
    - match: '\]'
      scope: punctuation.section.array.end.toml
      pop: true
    - include: comments
    - match: ','
      scope: punctuation.separator.array.toml
    - match: '(?=[^\s,\]#])'
      push: value

  inline-table:
    - meta_scope: meta.inline-table.toml
    - match: '\}'
      scope: punctuation.section.inline-table.end.toml
      pop: true
    - match: ','
      scope: punctuation.separator.inline-table.toml
    - include: keys
    - match: '='
      scope: keyword.operator.assignment.toml
      push: value

  escapes:
    - match: '\\(?:[btnfre"\\]|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})'
      scope: constant.character.escape.toml
    - match: '\\.'
      scope: invalid.illegal.escape.toml

  string-basic:
    - meta_scope: string.quoted.double.toml
    - match: '"'
      scope: punctuation.definition.string.end.toml
      pop: true
    - include: escapes
    - match: '$'
      pop: true

  string-literal:
    - meta_scope: string.quoted.single.toml
    - match: "'"
      scope: punctuation.definition.string.end.toml
      pop: true
    - match: '$'
      pop: true

  # Up to two quotes may end the text just before the closing three.
  string-basic-multiline:
    - meta_scope: string.quoted.triple.double.toml
    - match: '"{3,5}'
      scope: punctuation.definition.string.end.toml
      pop: true
    - match: '\\\s*$'
      scope: constant.character.escape.line-ending.toml
    - include: escapes

  string-literal-multiline:
    - meta_scope: string.quoted.triple.single.toml
    - match: "'{3,5}"
      scope: punctuation.definition.string.end.toml
      pop: true
